# Real MongoDB (Atlas or local). Do NOT enable memory mode if you want persistent data.
MONGO_URI=mongodb://127.0.0.1:27017/mrantidot-v2

# Force empty in-memory DB (demo only). Keep false for real env database.
# USE_MEMORY_MONGO=true
# MONGO_URI=memory

# Production (Render / Atlas): use mongodb+srv://.../mrantidot (no "." in DB name)
JWT_SECRET=supersecret_change_me
PORT=4001
NODE_ENV=development
CLIENT_URL=*

# Admin account — synced to MongoDB on server start
ADMIN_PHONE=9000000001
ADMIN_PASSWORD=admin123
ADMIN_NAME="Ravi Admin"
ADMIN_EMAIL=admin@mrantidot.com
ADMIN_CITY=Mumbai

ENSURE_ADMIN_ON_STARTUP=true

# Load demo seed data on boot (default off — use npm run seed manually if needed)
SEED_ON_START=false
ALLOW_DEMO_COUPONS=false
