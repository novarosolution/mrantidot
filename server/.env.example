# Real MongoDB (Atlas or local). Do NOT enable memory mode if you want persistent data.
MONGO_URI=mongodb://127.0.0.1:27017/mrantidot-v2

# No MongoDB installed? Use the embedded database instead (development only).
# Data is saved in server/.data/mongo and survives restarts; `npm run db:reset` wipes it.
# Set LOCAL_DB_DIR= (empty) for a throwaway database that is wiped on every stop.
# USE_MEMORY_MONGO=true
# LOCAL_DB_DIR=.data/mongo

# Production (Render / Atlas): use mongodb+srv://.../mrantidot (no "." in DB name)
JWT_SECRET=supersecret_change_me
PORT=4001
NODE_ENV=development
CLIENT_URL=*

# Admin account — synced to MongoDB on server start
ADMIN_PHONE=9000000001
ADMIN_PASSWORD=admin123
ADMIN_NAME="Ravi Admin"
ADMIN_EMAIL=admin@mrantidot.com
ADMIN_CITY=Mumbai

ENSURE_ADMIN_ON_STARTUP=true

# Demo seed data on boot:
#   if-empty  seed only a brand-new database (recommended for local dev)
#   true      reset demo users/bookings on EVERY start (wipes your changes)
#   false     never seed
SEED_ON_START=false
ALLOW_DEMO_COUPONS=false
