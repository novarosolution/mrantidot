{
  "name": "mrantidot",
  "version": "1.0.0",
  "private": true,
  "description": "Mr Antidot — home-services booking platform",
  "workspaces": [
    "server",
    "mobile"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:mobile": "npm run start --workspace=mobile",
    "start:mobile": "npm run start --workspace=mobile",
    "seed": "npm run seed --workspace=server",
    "ios": "npm run ios --workspace=mobile",
    "android": "npm run android --workspace=mobile",
    "build": "npm run build --workspace=server",
    "build:server": "npm run build --workspace=server",
    "start": "npm run start --workspace=server",
    "build:apk": "bash scripts/build-apk.sh",
    "build:apk:eas": "npm run build:apk:eas --workspace=mobile",
    "deploy:check": "node scripts/check-deploy-config.cjs",
    "deploy:config": "node scripts/check-deploy-config.cjs",
    "clean:appledouble": "bash scripts/clean-appledouble.sh",
    "clean:gradle": "bash scripts/clean-gradle-appledouble.sh",
    "test": "bash scripts/test-all.sh",
    "test:api": "bash server/test/auth.sh && bash server/test/flow.sh && bash server/test/features.sh"
  },
  "engines": {
    "node": ">=18"
  }
}
