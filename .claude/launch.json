{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile-expo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:mobile"
      ],
      "port": 8081
    },
    {
      "name": "mobile-expo-ios",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "exec",
        "--workspace=mobile",
        "--",
        "expo",
        "start",
        "--ios",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "api-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:server"],
      "port": 4001
    },
    {
      "name": "web-next",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "mranti",
        "run",
        "dev",
        "--",
        "-p",
        "3000"
      ],
      "port": 3000
    }
  ]
}