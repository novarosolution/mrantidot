{
  "name": "@mrantidot/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "prestart": "bash ../scripts/clean-appledouble.sh",
    "predev": "bash ../scripts/clean-appledouble.sh",
    "preandroid": "bash ../scripts/clean-appledouble.sh",
    "preios": "bash ../scripts/clean-appledouble.sh",
    "start": "npx expo start",
    "dev": "npx expo start",
    "android": "npx expo start --android -c",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "build:apk": "bash ../scripts/build-apk.sh",
    "build:apk:eas": "eas build -p android --profile preview",
    "build:production": "node ../scripts/check-deploy-config.cjs && eas build -p android --profile production",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo-google-fonts/sora": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "axios": "^1.16.1",
    "expo": "~56.0.0",
    "expo-blur": "~56.0.3",
    "expo-camera": "~56.0.8",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.20",
    "expo-font": "~56.0.7",
    "expo-image-picker": "~56.0.20",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.15",
    "expo-location": "~56.0.20",
    "expo-modules-autolinking": "^56.0.19",
    "expo-router": "~56.2.14",
    "expo-splash-screen": "~56.0.12",
    "expo-status-bar": "~56.0.4",
    "lucide-react-native": "^1.17.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "^2.3.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
