# Production API URL — see deploy.config.json at repo root (used by EAS builds).
# Dev uses auto-detected Metro host (lib/config.ts). Port must match server/.env PORT.
# EXPO_PUBLIC_API_URL=http://127.0.0.1:4001
# Physical device when Metro host detect fails:
# EXPO_PUBLIC_API_URL=http://192.168.1.13:4001
# EXPO_PUBLIC_API_URL_FORCE=true
